}
#panel-attendance .att-tab:nth-child(5).active {
    border-bottom-color: #059669;
    color: #059669;
}

/* 活动费用框架展示区 */
#activity-fee-display {
    margin-bottom: 12px;
    padding: 12px 16px;
    background: #fafbfc;
    border-radius: 10px;
    border: 1px solid #e8ecf1;
