    color: #888;
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}
#activity-fee-display .fee-framework-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
}
#activity-fee-display .fee-framework-type {
    font-size: 10px;
