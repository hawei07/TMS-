#activity-fee-display .fee-framework-detail {
    font-size: 13px;
    font-weight: 600;
    color: #555;
}

/* ============================================================
   活动考勤弹窗 — 4步重设计 CSS
   ============================================================ */

/* ---------- 基础弹窗框架 ---------- */
.att-modal-dialog {
    width: 1100px;
    max-width: 95vw;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 12px 60px rgba(0,0,0,0.15);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 92vh;
}
.att-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 28px;
    background: #FFF9E0;
    border-bottom: 3px solid #FFE066;
}
.att-modal-title-group {
    display: flex;
    align-items: center;
    gap: 12px;
}
.att-modal-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: #FFE066;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.att-modal-icon svg {
    width: 22px;
    height: 22px;
    color: #E17055;
}
.att-modal-title-group h3 {
    font-size: 19px;
    font-weight: 700;
    color: #2d3436;
    margin: 0;
    line-height: 1.3;
}
.att-modal-subtitle {
    font-size: 13px;
    color: #888;
    margin-top: 2px;
    font-weight: 400;
}
.att-modal-body {
    padding: 24px 28px;
    overflow-y: auto;
    flex: 1;
    min-height: 380px;
}
.att-modal-footer {
    display: flex;
    justify-content: center;
    gap: 12px;
    padding: 16px 28px;
    background: #fafbfc;
    border-top: 1px solid #eef0f4;
}

/* ---------- 4步进度条 ---------- */
.att-progress-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 28px 0;
    gap: 0;
    position: relative;
}
.att-progress-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    position: relative;
    z-index: 1;
}
.att-progress-dot {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 700;
    transition: all 0.3s ease;
    flex-shrink: 0;
}
.att-progress-step .att-progress-dot {
    background: #eef0f4;
    color: #b2bec3;
    border: 2px solid #dfe6e9;
}
.att-progress-step.completed .att-progress-dot {
    background: #FF7675;
    color: #fff;
    border: 2px solid #FF7675;
}
.att-progress-step.completed .att-progress-dot::after {
    content: '✓';
    font-size: 16px;
}
.att-progress-step.current .att-progress-dot {
    background: #fff;
    color: #FF7675;
    border: 3px solid #FF7675;
    width: 42px;
    height: 42px;
    font-size: 16px;
    box-shadow: 0 0 0 6px rgba(255, 118, 117, 0.15);
}
.att-progress-label {
    font-size: 12px;
    color: #b2bec3;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.3s;
}
.att-progress-step.completed .att-progress-label { color: #888; }
.att-progress-step.current .att-progress-label {
    color: #FF7675;
    font-weight: 700;
    font-size: 13px;
}
.att-progress-line {
    width: 80px;
    height: 3px;
    background: #dfe6e9;
    border-radius: 2px;
    margin: 0 8px;
    margin-bottom: 22px;
    transition: background 0.3s;
    flex-shrink: 0;
}
.att-progress-line.completed { background: #FF7675; }

/* ---------- 通用步骤内容 ---------- */
.att-step-content {
    display: none;
    animation: att-step-fadeIn 0.35s ease;
}
.att-step-content.active { display: block; }
@keyframes att-step-fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
}
.att-step-section { margin-bottom: 20px; }
.att-step-section-title {
    font-size: 16px;
    font-weight: 700;
    color: #2d3436;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
}
.att-step-hint {
    text-align: center;
    color: #b2bec3;
    font-size: 13px;
    margin-top: 16px;
    padding: 10px 16px;
    background: #f8f9fb;
    border-radius: 10px;
}

/* ---------- Step 1: 报名详情卡片 ---------- */
.att-enroll-card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-bottom: 18px;
}
.att-info-card {
    padding: 18px 20px;
    background: #FFF9E0;
    border-radius: 14px;
    border: 2px solid #FFE066;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transition: transform 0.2s;
}
.att-info-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(255, 224, 102, 0.3);
}
.att-info-card .att-card-icon { font-size: 22px; line-height: 1; }
.att-info-card .att-card-label { font-size: 12px; color: #888; font-weight: 500; text-transform: uppercase; letter-spacing: 0.5px; }
.att-info-card .att-card-value { font-size: 18px; font-weight: 700; color: #2d3436; }
.att-info-card .att-card-value.price { color: #E17055; font-size: 20px; }
.att-info-card.adult-card { border-left: 4px solid #55EFC4; background: #f0fdf6; }
.att-info-card.student-card { border-left: 4px solid #74B9FF; background: #f0f7ff; }

.att-deduction-rule-cards { display: flex; flex-direction: column; gap: 10px; }
.att-rule-card {
    padding: 14px 18px;
    background: #FFF9E0;
    border: 1px solid #FFE066;
    border-left: 4px solid #FF7675;
    border-radius: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: #555;
}
.att-rule-card .att-rule-icon { font-size: 20px; flex-shrink: 0; }
.att-rule-card .att-rule-type { font-weight: 700; color: #FF7675; min-width: 36px; }
.att-rule-card .att-rule-detail { color: #555; flex: 1; }
.att-rule-card .att-rule-value { font-weight: 700; color: #E17055; font-size: 16px; }
.att-rule-no-deduction {
    padding: 16px 20px;
    background: #f8f9fb;
    border: 2px dashed #dfe6e9;
    border-radius: 12px;
    text-align: center;
    color: #b2bec3;
    font-size: 14px;
}

/* ---------- Step 2: 出勤人数步进器 ---------- */
.att-stepper-panel {
    padding: 20px 24px;
    border-radius: 16px;
    border: 2px solid #eef0f4;
    background: #fff;
    margin-bottom: 14px;
    transition: border-color 0.2s;
}
.att-stepper-panel.adult-panel { border-left: 4px solid #55EFC4; background: #fafffe; }
