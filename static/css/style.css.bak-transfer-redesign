.ba-tree-wrap {
    flex: 1; overflow-y: auto;
    padding: 8px 0;
}

/* 批量分配 - 组织树节点 */
.ba-tree-node {
    user-select: none;
}

.ba-tree-node .ba-node-children {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.25s ease;
}

.ba-tree-node.expanded > .ba-node-children {
    max-height: 5000px;
}

.ba-node-row {
    display: flex;
    align-items: center;
    padding: 6px 12px 6px 0;
    cursor: pointer;
    border-left: 3px solid transparent;
    transition: background 0.15s;
}

.ba-node-row:hover {
    background: #eef1f5;
}

.ba-tree-node.selected > .ba-node-row {
    background: #e6f0ff;
    border-left-color: var(--color-primary);
}

.ba-node-toggle {
    width: 20px; height: 20px;
    display: inline-flex;
    align-items: center; justify-content: center;
    flex-shrink: 0;
    cursor: pointer;
    color: #999;
    font-size: 10px;
    border-radius: 3px;
}

.ba-node-toggle:hover { background: #e0e0e0; color: #333; }

.ba-node-toggle-placeholder {
    cursor: default;
    width: 20px; height: 20px;
    display: inline-flex;
    align-items: center; justify-content: center;
    flex-shrink: 0;
}

.ba-toggle-icon {
    transition: transform 0.2s;
}

.ba-node-label {
    flex: 1;
    font-size: 13px;
    color: #333;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 2px 4px;
    border-radius: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ba-node-count {
    font-size: 11px;
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-left: auto;
}

/* 右侧 */
.ba-right {
    flex: 1;
    display: flex; flex-direction: column;
    overflow: hidden;
    min-width: 0;
}

.ba-search-bar {
    display: flex;
    gap: 8px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--color-border-light);
    flex-shrink: 0;
}

.ba-search-bar input {
    flex: 1;
    padding: 8px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 13px;
    outline: none;
    transition: border-color var(--transition);
}

.ba-search-bar input:focus {
    border-color: var(--color-primary);
}

.ba-list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    border-bottom: 1px solid var(--color-border-light);
    flex-shrink: 0;
}

.ba-check-all {
    display: flex; align-items: center; gap: 6px;
    font-size: 13px; color: var(--color-text);
    cursor: pointer;
}

.ba-selected-count {
    font-size: 12px;
    color: var(--color-primary);
    font-weight: 500;
}

.ba-list-wrap {
    flex: 1;
    overflow-y: auto;
}

.ba-employee-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--color-border-light);
    transition: background var(--transition);
    cursor: pointer;
}

.ba-employee-item:hover {
    background: var(--color-primary-bg);
}

.ba-employee-item.selected {
    background: #f5f0ff;
}

.ba-employee-item input[type="checkbox"] {
    flex-shrink: 0;
}

.ba-emp-name {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text);
    min-width: 80px;
}

.ba-emp-phone {
    font-size: 12px;
    color: var(--color-text-muted);
}

.btn-cancel {
    border-color: var(--color-danger);
    color: var(--color-danger);
}

.btn-cancel:hover {
    background: var(--color-danger-bg);
}

/* ==================== 价格管理 ==================== */
.price-left {
    width: 220px;
    min-width: 220px;
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
}
.price-left-header {
    padding: 12px 16px;
    font-weight: 600;
    font-size: 14px;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
}
.price-plan-list-wrap {
    flex: 1;
    overflow-y: auto;
    padding: 4px;
}
.price-plan-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    margin: 2px 0;
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-size: 13px;
    transition: background 0.15s;
}
.price-plan-item:hover { background: var(--color-primary-hover); }
.price-plan-item.active { background: var(--color-primary-bg); color: var(--color-primary); font-weight: 600; }
.price-plan-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.price-plan-actions { display: none; gap: 2px; }
.price-plan-item:hover .price-plan-actions { display: flex; }
.price-plan-actions .btn-link { font-size: 11px; padding: 1px 4px; }
.price-plan-actions .btn-link-danger { font-size: 11px; padding: 1px 4px; }
.price-left-footer {
    padding: 8px;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
}

.price-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}
.price-right-header {
    padding: 12px 16px;
    font-weight: 600;
    font-size: 14px;
    border-bottom: 1px solid var(--color-border);
}
.price-item-table-wrap {
    flex: 1;
    overflow-y: auto;
    padding: 0 16px;
}
.price-item-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
}
.price-item-table th {
    position: sticky;
    top: 0;
    background: var(--color-surface);
    padding: 10px 8px;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
    font-weight: 600;
    color: var(--color-text-secondary);
    z-index: 1;
}
.price-item-table td {
    padding: 8px;
    border-bottom: 1px solid var(--color-border-light);
}
.price-item-table .price-total-row td {
    font-weight: bold;
    border-top: 2px solid var(--color-border);
    border-bottom: 2px solid var(--color-border);
    background: #f0f4ff;
    padding: 10px 8px;
}
.price-right-footer {
    padding: 12px 16px;
    border-top: 1px solid var(--color-border);
}

/* ==================== 学员详情标签页 ==================== */
.student-detail-tabs {
    display: flex;
    gap: 2px;
    border-bottom: 1.5px solid #e9ebf0;
    padding: 0 16px;
    margin-top: 8px;
}

.sdt-tab {
    padding: 10px 20px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1.5px;
    cursor: pointer;
    font-size: 13.5px;
    color: #64748b;
    transition: color 0.2s cubic-bezier(0.25,1,0.5,1), border-color 0.2s cubic-bezier(0.25,1,0.5,1), background 0.15s cubic-bezier(0.25,1,0.5,1);
    border-radius: 8px 8px 0 0;
    letter-spacing: 0.01em;
}

.sdt-tab:hover {
    color: var(--color-primary);
    background: rgba(124,58,237,0.04);
}

.sdt-tab.active {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
    font-weight: 600;
    background: rgba(124,58,237,0.04);
}

.student-detail-tab-content {
    min-height: 200px;
}

.sdt-panel {
    display: none;
}

.sdt-panel.active {
    display: block;
}

/* 账户交易类型标签 */
.type-tag {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 500;
}
.type-tag-deposit {
    background: #e8f5e9;
    color: #27ae60;
}
.type-tag-consume {
    background: #fde8e8;
    color: #e74c3c;
}
.type-tag-refund {
    background: #fef3e8;
    color: #e67e22;
}

/* 账户余额卡片移动端适配 */
@media (max-width: 640px) {
    #account-balance-cards {
        flex-direction: column;
    }
    #account-balance-cards > div {
        min-width: 0 !important;
    }
    #account-filter-bar {
        flex-direction: column;
        align-items: flex-start !important;
        gap: 8px !important;
    }
    #account-filter-bar select,
    #account-filter-bar input[type="date"] {
        width: 100% !important;
    }
    #tab-account .pagination {
        flex-wrap: wrap;
        gap: 4px;
    }
}

/* 出勤状态标签 */
.status-tag.status-缺勤 {
    background: #fef0f0;
    color: #e74c3c;
}

.status-tag.status-请假 {
    background: #fdf6ec;
    color: #e6a23c;
}

.status-tag.status-出勤 {
    background: #f0f9eb;
    color: #67c23a;
}


/* ==================== 报名详情页面 ==================== */
/* ==================== 报名详情面板 ==================== */

/* ============================
   报名页面 — 重新设计 CSS
   紫色主题 #7C3AED · Pill 圆角 · 卡片阴影 · 渐变
   ============================ */

/* --- 学员信息卡片 --- */
.enroll-student-info {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 24px 28px;
    background: linear-gradient(135deg, #faf8ff 0%, #f3eefc 50%, #ede4ff 100%);
    border-bottom: 1px solid rgba(124, 58, 237, 0.08);
    position: relative;
    overflow: hidden;
}
.enroll-student-info::before {
    content: '';
    position: absolute;
    top: -40px; right: -40px;
    width: 140px; height: 140px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.04) 0%, transparent 70%);
    pointer-events: none;
}
.enroll-student-avatar {
    width: 52px; height: 52px;
    border-radius: 50%;
    background: linear-gradient(135deg, #7C3AED 0%, #9F6FF0 50%, #A78BFA 100%);
    display: flex; align-items: center; justify-content: center;
    color: #fff;
    flex-shrink: 0;
    box-shadow: 0 4px 14px rgba(124, 58, 237, 0.25);
    position: relative;
    z-index: 1;
}
.enroll-student-avatar svg {
    width: 22px; height: 22px;
}
.enroll-student-details {
    flex: 1; min-width: 0;
    position: relative; z-index: 1;
}
.enroll-student-name {
    font-size: 17px; font-weight: 700;
    color: #1E1B2E;
    line-height: 1.3;
    letter-spacing: -0.2px;
}
.enroll-student-phone {
    font-size: 13px; color: #7C3AED;
    margin-top: 3px;
    font-weight: 500;
}

/* --- 表单区域 --- */
.enroll-form {
    padding: 28px 28px 32px;
}

/* --- 校区/课程并排 --- */
.enroll-form-row {
    display: flex; gap: 16px;
}
.enroll-form-half {
    flex: 1; min-width: 0;
}

/* --- 区块 --- */
.enroll-section {
    margin-top: 24px;
    animation: enrollFadeSlideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes enrollFadeSlideIn {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* --- 区块标题 --- */
.enroll-section-title {
    font-size: 14px; font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0.2px;
    margin-bottom: 14px;
    display: flex; align-items: center; gap: 10px;
}
.enroll-section-title::before {
    content: '';
    width: 4px; height: 18px;
    border-radius: 2px;
    background: linear-gradient(180deg, #7C3AED, #A78BFA);
    flex-shrink: 0;
}
.enroll-section-title::after {
    content: '';
    flex: 1; height: 1px;
    background: linear-gradient(90deg, var(--color-border-light), transparent);
}

/* --- 价格方案卡片（网格布局） --- */
#enroll-plans-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
}
.enroll-plan-card {
    padding: 12px 16px;
    border: 2px solid #E2E0E7;
    border-radius: 12px;
    justify-content: flex-start;
    cursor: pointer;
    transition: all 0.2s ease;
    background: var(--color-surface);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}
.enroll-plan-card:hover {
    border-color: var(--color-primary-light);
    background: #faf8ff;
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(124, 58, 237, 0.10);
}
.enroll-plan-card.active {
    border-color: #7C3AED;
    background: linear-gradient(135deg, #f5f0ff 0%, #faf6ff 100%);
    box-shadow: inset 0 0 0 1px rgba(124, 58, 237, 0.25),
                      0 2px 12px rgba(124, 58, 237, 0.12);
}
.enroll-plan-card.active::after {
    content: '✓';
    position: absolute; top: -6px; right: -6px;
    width: 20px; height: 20px;
    background: linear-gradient(135deg, #7C3AED, #9F6FF0);
    color: #fff;
    border-radius: 50%;
    font-size: 11px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 8px rgba(124, 58, 237, 0.35);
    z-index: 1;
    animation: checkPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes checkPop {
    from { transform: scale(0); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
}

.enroll-plan-card:focus-visible {
    outline: 2px solid #7C3AED;
    outline-offset: 2px;
    border-radius: 14px;
}
.enroll-plan-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text);
    position: relative; z-index: 1;
}

.enroll-plan-price {
    font-size: 18px;
    font-weight: 700;
    color: #7C3AED;
    letter-spacing: -0.3px;
    white-space: nowrap;
    font-feature-settings: "tnum";
}

.enroll-plan-meta {
    display: flex;
    gap: 10px;
    font-size: 12px;
    color: #9895A8;
    margin-top: 4px;
}

/* --- 报价表格 --- */
.enroll-table-wrap {
    background: var(--color-bg);
    border: 1px solid var(--color-border-light);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
}
.enroll-items-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
}
.enroll-items-table thead th {
    background: #f8f7fc;
    padding: 12px 18px;
    text-align: left;
    font-weight: 700;
    font-size: 12px;
    color: var(--color-text-secondary);
    letter-spacing: 0.3px;
    border-bottom: 2px solid var(--color-border-light);
    text-transform: uppercase;
}
.enroll-items-table thead th.col-num {
    text-align: right;
}
.enroll-items-table tbody td {
    padding: 14px 18px;
    border-bottom: 1px solid var(--color-border-light);
    color: var(--color-text);
    font-weight: 500;
    transition: background 0.2s;
}
.enroll-items-table tbody tr:hover td {
    background: #fdfbff;
}
.enroll-items-table tbody td.col-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
}
.enroll-items-table tbody tr:last-child td {
    border-bottom: none;
}

/* --- 合计金额栏 --- */
.enroll-total-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 24px;
    background: linear-gradient(135deg, #faf8ff 0%, #f5f0ff 100%);
    border: 1px solid rgba(124, 58, 237, 0.1);
    border-top: none;
    border-radius: 0 0 12px 12px;
}
.enroll-total-label {
    font-size: 14px; font-weight: 700;
    color: var(--color-text);
}
.enroll-total-amount {
    font-size: 24px; font-weight: 800;
    color: var(--color-primary);
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.5px;
}
/* --- 支付方式卡片 --- */
.enroll-payment-row {
    display: flex; gap: 16px;
}
.enroll-payment-card {
    flex: 1;
    min-width: 200px;
    padding: 20px 22px;
    border: 2px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    position: relative;
    overflow: hidden;
}
.enroll-payment-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
    border-radius: inherit;
}
/* 现金卡片 — 绿色主题 */
.enroll-payment-card:first-child {
    border-left: 4px solid transparent;
}
.enroll-payment-card:first-child:hover,
.enroll-payment-card:first-child:focus-within {
    border-color: #38A169;
    box-shadow: 0 4px 16px rgba(56, 161, 105, 0.12);
    background: #f6fdf9;
}
.enroll-payment-card:first-child::before {
    background: linear-gradient(135deg, rgba(56, 161, 105, 0.04) 0%, transparent 100%);
}
.enroll-payment-card:first-child:hover::before,
.enroll-payment-card:first-child:focus-within::before {
    opacity: 1;
}
/* 美团卡片 — 黄色主题 */
.enroll-payment-card:nth-child(2):hover,
.enroll-payment-card:nth-child(2):focus-within {
    border-color: #FF6D00;
    box-shadow: 0 4px 16px rgba(255, 109, 0, 0.12);
    background: #fffaf5;
}
.enroll-payment-card:nth-child(2)::before {
    background: linear-gradient(135deg, rgba(255, 109, 0, 0.04) 0%, transparent 100%);
}
.enroll-payment-card:nth-child(2):hover::before,
.enroll-payment-card:nth-child(2):focus-within::before {
    opacity: 1;
}
/* 账户余额卡片 — 蓝色主题 */
.enroll-payment-card:last-child:hover,
.enroll-payment-card:last-child:focus-within {
    border-color: #3B82F6;
    box-shadow: 0 4px 16px rgba(59, 130, 246, 0.12);
    background: #f5f9ff;
}
.enroll-payment-card:last-child::before {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.04) 0%, transparent 100%);
}
.enroll-payment-card:last-child:hover::before,
.enroll-payment-card:last-child:focus-within::before {
    opacity: 1;
}
.enroll-payment-header {
    display: flex; align-items: center; gap: 12px;
    margin-bottom: 14px;
}
.enroll-payment-icon {
    width: 38px; height: 38px;
    border-radius: 10px;
    background: linear-gradient(135deg, #e6f7ed, #c8f0d6);
    display: flex; align-items: center; justify-content: center;
    color: #38A169;
    box-shadow: 0 2px 8px rgba(56, 161, 105, 0.12);
    transition: all 0.25s;
}
.enroll-payment-card:first-child:hover .enroll-payment-icon,
.enroll-payment-card:first-child:focus-within .enroll-payment-icon {
    transform: scale(1.08);
    box-shadow: 0 3px 12px rgba(56, 161, 105, 0.2);
}
.enroll-payment-icon-meituan {
    background: linear-gradient(135deg, #fff3e5, #ffe4cc);
    color: #FF6D00;
    box-shadow: 0 2px 8px rgba(255, 109, 0, 0.12);
}
.enroll-payment-card:last-child:hover .enroll-payment-icon-meituan,
.enroll-payment-card:last-child:focus-within .enroll-payment-icon-meituan {
    transform: scale(1.08);
    box-shadow: 0 3px 12px rgba(255, 109, 0, 0.2);
}
.enroll-payment-icon svg {
    width: 18px; height: 18px;
}
.enroll-payment-label {
    font-size: 15px; font-weight: 700;
    color: var(--color-text);
    letter-spacing: 0.2px;
}
.enroll-payment-input {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid var(--color-border);
    border-radius: 10px;
    font-size: 18px; font-weight: 700;
    color: var(--color-text);
    text-align: right;
    font-variant-numeric: tabular-nums;
    background: #fafafb;
    transition: all 0.25s;
    font-family: inherit;
    letter-spacing: 0.3px;
}
.enroll-payment-card:first-child .enroll-payment-input:focus {
    outline: none;
    border-color: #38A169;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(56, 161, 105, 0.08);
}
.enroll-payment-card:last-child .enroll-payment-input:focus {
    outline: none;
    border-color: #FF6D00;
    background: #fff;
    box-shadow: 0 0 0 4px rgba(255, 109, 0, 0.08);
}
.enroll-payment-input::placeholder {
    color: var(--color-text-muted);
    font-weight: 400;
    font-size: 15px;
}

/* --- 支付提示 --- */
.enroll-payment-hint {
    margin-top: 14px;
    font-size: 13px;
    padding: 12px 18px;
    border-radius: 10px;
    font-weight: 600;
    animation: enrollFadeSlideIn 0.3s ease;
}
.enroll-payment-hint.warn {
    background: #fff8f0;
    color: #e65100;
    border: 1px solid #ffe0b2;
}
.enroll-payment-hint.ok {
    background: #f0faf4;
    color: #2e7d32;
    border: 1px solid #c8e6c9;
}

/* --- 操作栏 --- */
.enroll-action-bar {
    margin-top: 28px;
    display: flex; justify-content: center; gap: 12px;
}
#btn-confirm-pay {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    padding: 14px 56px;
    font-weight: 700;
    letter-spacing: 0.3px;
    border-radius: 50px;
    background: linear-gradient(135deg, #7C3AED 0%, #9F6FF0 50%, #6D28D9 100%);
    border: none;
    color: #fff;
    box-shadow: 0 4px 20px rgba(124, 58, 237, 0.35), 0 2px 6px rgba(124, 58, 237, 0.2);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    cursor: pointer;
}
#btn-confirm-pay::before {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    width: 0; height: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transform: translate(-50%, -50%);
    transition: width 0.6s, height 0.6s;
}
#btn-confirm-pay:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(124, 58, 237, 0.45), 0 4px 10px rgba(124, 58, 237, 0.3);
}
#btn-confirm-pay:hover::before {
    width: 400px; height: 400px;
}
#btn-confirm-pay:active {
    transform: translateY(1px);
    box-shadow: 0 2px 10px rgba(124, 58, 237, 0.25);
}
#btn-confirm-pay svg {
    width: 20px; height: 20px;
    flex-shrink: 0;
    position: relative; z-index: 2;
}
#btn-confirm-pay * {
    position: relative; z-index: 2;
}

