/* ==================== 课程选择复合组件 ==================== */
.course-picker-body {
    background: #F8F7FC;
    border: 1.5px solid #E2E0E7;
    border-radius: 12px;
    padding: 12px;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.course-picker-body.has-selection {
    border-color: #7C3AED;
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.08);
}

/* 搜索框 */
.course-picker-search {
    position: relative;
    margin-bottom: 10px;
}
.course-picker-search .search-icon {
    position: absolute;
    left: 12px; top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
}
.course-picker-search input {
    width: 100%;
    padding: 9px 14px 9px 36px;
    border: 1.5px solid #E2E0E7;
    border-radius: 10px;
    font-size: 13px;
    color: #1E1B2E;
    background: #FFFFFF;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.course-picker-search input:focus {
    border-color: #7C3AED;
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.08);
}
.course-picker-search input:disabled {
    background: #F0EFF4;
    color: #9895A8;
    cursor: not-allowed;
}
.course-picker-search input::placeholder { color: #9895A8; }

/* 学科筛选 Chips */
.course-picker-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 10px;
    min-height: 0;
}
.course-picker-chip {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    font-size: 12px;
    font-weight: 500;
    color: #6B6880;
    background: #FFFFFF;
    border: 1px solid #E2E0E7;
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.2s ease;
    user-select: none;
    white-space: nowrap;
}
.course-picker-chip:hover {
    border-color: #A78BFA;
    color: #7C3AED;
    background: #F5F0FF;
}
.course-picker-chip.active {
    background: #7C3AED;
    color: #FFFFFF;
    border-color: #7C3AED;
    box-shadow: 0 2px 8px rgba(124, 58, 237, 0.25);
}
.course-picker-chip .chip-count {
    margin-left: 4px;
    font-size: 10px;
    opacity: 0.8;
}

/* 课程卡片列表 — 网格布局 */
.course-picker-list {
    max-height: 280px;
    overflow-y: auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 8px;
    scrollbar-width: thin;
    scrollbar-color: #E2E0E7 transparent;
}
.course-picker-list::-webkit-scrollbar { width: 5px; }
.course-picker-list::-webkit-scrollbar-track { background: transparent; }
.course-picker-list::-webkit-scrollbar-thumb {
    background: #E2E0E7;
    border-radius: 10px;
}

.course-picker-empty {
    padding: 28px 12px;
    text-align: center;
    color: #9895A8;
    font-size: 13px;
}

/* 课程卡片 — 紧凑网格 */
.course-picker-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: #FFFFFF;
    border: 1.5px solid #E2E0E7;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
}
.course-picker-card:hover {
    border-color: #A78BFA;
    background: #FAF8FF;
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(124, 58, 237, 0.08);
}
.course-picker-card.selected {
    border-color: #7C3AED;
    background: linear-gradient(135deg, #F5F0FF, #FAF6FF);
    box-shadow: 0 0 0 1px rgba(124, 58, 237, 0.15);
}
.course-picker-card.selected .course-card-check {
    opacity: 1;
    transform: scale(1);
}

.course-card-info { flex: 1; min-width: 0; }
.course-card-name {
    font-size: 14px;
    font-weight: 600;
    color: #1E1B2E;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.course-card-subject {
    font-size: 11px;
    color: #9895A8;
    margin-top: 2px;
}

.course-card-check {
    width: 18px; height: 18px;
    border-radius: 50%;
    background: #7C3AED;
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    opacity: 0;
    transform: scale(0);
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    flex-shrink: 0;
    margin-left: 8px;
}

/* ==================== 上课时段设置 ==================== */
.period-add-row { flex-wrap: wrap; align-items: center; }
.period-input-name { flex: 2; min-width: 140px; }
.period-input-time { width: 120px; flex: none; padding: 9px 12px; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: 13px; outline: none; transition: all var(--transition); font-family: inherit; }
.period-input-time:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(124,58,237,0.08); }
.period-separator { font-size: 13px; color: var(--color-text-muted); white-space: nowrap; flex: none; }
.period-input-campus { width: 120px; flex: none; padding: 9px 10px; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: 13px; outline: none; font-family: inherit; }
.period-input-sort { width: 80px; flex: none; padding: 9px 10px; border: 1px solid var(--color-border); border-radius: var(--radius-md); font-size: 13px; outline: none; transition: all var(--transition); font-family: inherit; }
.period-input-sort:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(124,58,237,0.08); }
#table-periods thead th:first-child, #table-periods tbody td:first-child { text-align: center; }
#table-periods thead th:nth-child(3), #table-periods thead th:nth-child(4), #table-periods tbody td:nth-child(3), #table-periods tbody td:nth-child(4) { text-align: center; font-variant-numeric: tabular-nums; }

/* ==================== 退费申请弹窗 — 退费方式 radio 组 ==================== */

