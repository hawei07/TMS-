/* ==================== 画具管理 - 购买画具 & 销售记录 ==================== */
/* OKLCH warm-terracotta palette — frontend-design skill */

#panel-teaching-aids {
    --ta-brand-hue: 22;
    --ta-brand-50:  oklch(96% 0.012 var(--ta-brand-hue));
    --ta-brand-100: oklch(90% 0.028 var(--ta-brand-hue));
    --ta-brand-200: oklch(82% 0.055 var(--ta-brand-hue));
    --ta-brand-300: oklch(72% 0.085 var(--ta-brand-hue));
    --ta-brand-400: oklch(62% 0.115 var(--ta-brand-hue));
    --ta-brand-500: oklch(53% 0.138 var(--ta-brand-hue));
    --ta-brand-600: oklch(44% 0.128 var(--ta-brand-hue));
    --ta-surface-0:   oklch(100% 0 none);
    --ta-surface-50:  oklch(98% 0.005 30);
    --ta-surface-100: oklch(95% 0.008 30);
    --ta-surface-200: oklch(91% 0.012 30);
    --ta-surface-300: oklch(85% 0.015 30);
    --ta-surface-500: oklch(62% 0.018 30);
    --ta-surface-700: oklch(37% 0.012 30);
    --ta-surface-800: oklch(25% 0.010 30);
    --ta-surface-900: oklch(17% 0.008 30);
    --ta-success:     oklch(58% 0.155 155);
    --ta-success-bg:  oklch(92% 0.038 155);
    --ta-danger:      oklch(53% 0.18 22);
    --ta-danger-bg:   oklch(94% 0.028 22);
    --ta-ease-out:    cubic-bezier(0.25, 1, 0.5, 1);
    --ta-ease-expo:   cubic-bezier(0.16, 1, 0.3, 1);
}

/* -- Panel header -- */
#panel-teaching-aids .panel-header { position: relative; overflow: hidden; }
#panel-teaching-aids .panel-header h3 {
    display: flex; align-items: center; gap: 10px;
}

/* -- Tab buttons -- */
#ta-tabs {
    display: flex; gap: 2px;
    border-bottom: 1.5px solid var(--ta-surface-200);
    margin-bottom: 20px; padding: 0 4px;
}
#ta-tabs .sec-tab {
    padding: 11px 20px; border: none; background: none;
    font-size: 13.5px; font-weight: 580; color: var(--ta-surface-500);
    cursor: pointer; border-bottom: 2px solid transparent;
    margin-bottom: -1.5px;
    transition: color 0.2s var(--ta-ease-out), border-color 0.2s var(--ta-ease-out), background 0.15s var(--ta-ease-out);
    border-radius: 8px 8px 0 0; position: relative; letter-spacing: 0.01em;
}
#ta-tabs .sec-tab:hover {
    color: var(--ta-brand-500);
    background: oklch(62% 0.115 22 / 0.06);
}
#ta-tabs .sec-tab.active {
    color: var(--ta-brand-500); border-bottom-color: var(--ta-brand-500);
    font-weight: 600; background: oklch(62% 0.115 22 / 0.06);
}

/* ===== Purchase Layout ===== */
.ta-purchase-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: 24px;
    align-items: start;
}
.ta-purchase-left { display: flex; flex-direction: column; gap: 20px; }
.ta-purchase-right {
    background: var(--ta-surface-0);
    border: 1px solid var(--ta-surface-200);
    border-radius: 14px;
    padding: 20px 22px;
    position: sticky; top: 16px;
    box-shadow: 0 2px 8px oklch(0% 0 0 / 0.04);
}

/* -- Section heading -- */
.ta-section-head {
    display: flex; align-items: center; gap: 10px; margin-bottom: 14px;
}
.ta-section-bar {
    width: 3.5px; height: 18px; background: var(--ta-brand-400);
    border-radius: 2px; flex-shrink: 0;
}
.ta-section-title {
    font-size: 14px; font-weight: 700; color: var(--ta-surface-900);
    letter-spacing: -0.01em;
}

/* -- Block container -- */
.ta-block {
    background: var(--ta-surface-0);
    border: 1px solid var(--ta-surface-200);
    border-radius: 12px;
    padding: 18px 20px;
}

/* -- Campus selection -- */
.ta-campus-select-row {
    display: flex;
    align-items: center;
    gap: 8px;
}
.ta-campus-label {
    font-size: 14px;
    color: var(--ta-surface-700);
    white-space: nowrap;
}
.ta-campus-select-input {
    width: 200px;
}

/* -- Student selection -- */
.ta-purchase-student-new {
    background: var(--ta-surface-50);
    border: 1px solid var(--ta-surface-200);
    border-radius: 12px;
    padding: 18px 20px;
}
.ta-student-search-new {
    position: relative;
    display: flex; align-items: center;
}
.ta-student-search-new .ta-search-icon {
    position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
    width: 16px; height: 16px; color: var(--ta-surface-500); pointer-events: none;
    z-index: 2;
}
.ta-student-search-new input.form-input {
    width: 100%; height: 40px;
    padding-left: 34px; padding-right: 12px;
    border: 1.5px solid var(--ta-surface-200);
    border-radius: 8px; font-size: 13px;
    transition: border-color 0.15s var(--ta-ease-out), box-shadow 0.15s var(--ta-ease-out);
}
.ta-student-search-new input.form-input:focus {
    border-color: var(--ta-brand-300);
    box-shadow: 0 0 0 3px oklch(72% 0.085 22 / 0.12);
}

/* Dropdown */
.ta-student-dropdown {
    position: absolute; top: 100%; left: 0; right: 0;
    background: var(--ta-surface-0);
    border: 1.5px solid var(--ta-surface-200);
    border-radius: 10px; box-shadow: 0 6px 20px oklch(0% 0 0 / 0.08);
    z-index: 100; max-height: 240px; overflow-y: auto; margin-top: 4px;
}
.ta-student-dropdown-item {
    padding: 10px 14px; font-size: 13px; cursor: pointer;
    border-bottom: 1px solid var(--ta-surface-100);
    transition: all 0.12s var(--ta-ease-out);
}
.ta-student-dropdown-item:last-child { border-bottom: none; }
.ta-student-dropdown-item:hover {
    background: var(--ta-brand-50); color: var(--ta-brand-600);
}

/* Selected student chip */
.ta-student-chip-new {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--ta-surface-0);
    border: 1.5px solid var(--ta-surface-200);
    border-radius: 24px; padding: 6px 14px 6px 6px;
    font-size: 13px; font-weight: 600; color: var(--ta-surface-800);
    margin-top: 10px;
}
.ta-chip-avatar {
    width: 28px; height: 28px; border-radius: 50%;
    background: var(--ta-brand-100);
    flex-shrink: 0;
}
.ta-chip-close {
    background: none; border: none; font-size: 18px; line-height: 1;
    color: var(--ta-surface-500); cursor: pointer;
    padding: 0 2px; border-radius: 50%;
    transition: all 0.12s var(--ta-ease-out);
    width: 22px; height: 22px; display: flex; align-items: center; justify-content: center;
}
.ta-chip-close:hover { color: var(--ta-danger); background: var(--ta-danger-bg); }
.ta-empty-hint { color: var(--ta-surface-500); font-size: 13px; margin-top: 8px; font-style: italic; }

/* Selected product row */
.ta-selected-row {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
}
.ta-selected-label { font-weight: 600; font-size: 13px; color: var(--ta-surface-700); }
.ta-selected-name  { color: var(--ta-brand-500); font-weight: 700; font-size: 13px; }
.ta-add-cart-btn   { font-size: 12px !important; padding: 6px 14px !important; }

/* Quantity stepper */
.ta-qty-stepper-new {
    display: inline-flex; align-items: center;
    border: 1px solid var(--ta-surface-200); border-radius: 6px; overflow: hidden;
}
.ta-qty-btn-new {
    width: 28px; height: 28px; border: none; background: var(--ta-surface-0);
    font-size: 15px; font-weight: 600; color: var(--ta-surface-700);
    cursor: pointer; transition: all 0.15s var(--ta-ease-out);
    display: flex; align-items: center; justify-content: center;
}
.ta-qty-btn-new:hover { background: var(--ta-surface-100); color: var(--ta-surface-900); }
.ta-qty-btn-new:active { background: var(--ta-surface-200); transform: scale(0.94); }
.ta-qty-val-new {
    width: 32px; text-align: center; font-size: 13px; font-weight: 700;
    color: var(--ta-surface-800);
}

/* Cart list */
.ta-cart-list {
    border: 1px solid var(--ta-surface-200); border-radius: 10px;
    overflow: hidden; background: var(--ta-surface-0);
}
.ta-cart-item {
    padding: 10px 14px; border-bottom: 1px solid var(--ta-surface-100);
    display: flex; align-items: center; gap: 8px;
    transition: background 0.12s var(--ta-ease-out);
}
.ta-cart-item:last-child { border-bottom: none; }
.ta-cart-item:hover { background: var(--ta-surface-50); }
.ta-cart-item-info {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap; width: 100%;
}
.ta-cart-item-name {
    font-weight: 700; font-size: 13px; min-width: 90px; color: var(--ta-surface-800);
}
.ta-cart-item-price  { color: var(--ta-surface-500); font-size: 12px; }
.ta-cart-item-qty .ta-qty-btn {
    width: 26px; height: 26px; font-size: 14px;
}
.ta-cart-item-qty .ta-qty-val {
    min-width: 28px; font-size: 13px;
}
.ta-cart-item-subtotal {
    font-weight: 700; color: var(--ta-brand-500); font-size: 14px;
    margin-left: auto; letter-spacing: -0.3px;
}
.ta-cart-item-remove {
    background: none; border: none; color: var(--ta-surface-300);
    cursor: pointer; font-size: 18px; line-height: 1;
    padding: 2px 4px; transition: all 0.12s var(--ta-ease-out); border-radius: 50%;
}
.ta-cart-item-remove:hover { color: var(--ta-danger); background: var(--ta-danger-bg); }

/* Cart summary */
.ta-cart-summary-new {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 12px 0 0; margin-top: 10px;
    border-top: 1.5px dashed var(--ta-surface-200);
}
.ta-summary-label  { font-size: 13px; font-weight: 500; color: var(--ta-surface-500); }
.ta-summary-amount { font-size: 18px; font-weight: 800; color: var(--ta-brand-500); }

/* Payment form */
.ta-payment-form { display: flex; flex-direction: column; gap: 14px; margin-bottom: 14px; }
.ta-payment-field { display: flex; align-items: center; gap: 10px; }
.ta-payment-field label {
    width: 62px; text-align: right; font-size: 13px; font-weight: 600;
    color: var(--ta-surface-700); flex-shrink: 0;
}
.ta-input-wrap {
    position: relative; display: flex; align-items: center; flex: 1;
}
.ta-input-prefix {
    position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
    font-size: 12px; color: var(--ta-surface-500); pointer-events: none; z-index: 2;
}
.ta-pay-input {
    width: 100%; height: 38px;
    padding-left: 20px; padding-right: 10px;
    font-size: 14px; font-weight: 600; text-align: right;
    border: 1.5px solid var(--ta-surface-200); border-radius: 7px;
    transition: border-color 0.15s var(--ta-ease-out), box-shadow 0.15s var(--ta-ease-out), background 0.15s var(--ta-ease-out);
}
.ta-pay-input:focus {
    border-color: var(--ta-brand-300);
    box-shadow: 0 0 0 3px oklch(72% 0.085 22 / 0.12);
    outline: none; background: var(--ta-surface-0);
}
.ta-input-suffix { margin-left: 6px; font-size: 12px; color: var(--ta-surface-500); flex-shrink: 0; }
.ta-input-hint   { margin-left: 6px; font-size: 11px; color: var(--ta-surface-500); white-space: nowrap; }
.ta-input-hint strong { color: var(--ta-surface-700); }
.ta-remark-input { width: 100%; height: 38px; font-size: 13px; }

/* Payment match */
.ta-payment-match {
    padding: 10px 14px; border-radius: 8px; font-size: 12px; font-weight: 600;
    margin-bottom: 14px; display: flex; align-items: center; gap: 6px;
}
.ta-payment-match-ok  { background: var(--ta-success-bg); color: #0d7d4a; border: 1.5px solid var(--ta-success); }
.ta-payment-match-err { background: var(--ta-danger-bg);  color: #c0392b; border: 1.5px solid var(--ta-danger); }

/* Purchase button */
.ta-purchase-btn-new {
    display: flex !important; align-items: center; justify-content: center; gap: 6px;
    width: 100%; height: 46px;
    font-weight: 700 !important; font-size: 15px !important;
    border-radius: 10px !important; letter-spacing: 0.01em;
    transition: all 0.2s var(--ta-ease-out) !important;
    border: none !important;
}
#ta-purchase-btn:not(:disabled) {
    background: var(--ta-brand-500) !important;
    color: #fff !important;
    box-shadow: 0 3px 10px oklch(53% 0.138 22 / 0.3);
}
#ta-purchase-btn:not(:disabled):hover {
    background: var(--ta-brand-600) !important;
    box-shadow: 0 5px 16px oklch(44% 0.128 22 / 0.35);
    transform: translateY(-1px);
}
#ta-purchase-btn:not(:disabled):hover .ta-btn-arrow { transform: translateX(3px); }
#ta-purchase-btn:not(:disabled):active { transform: translateY(0); }
#ta-purchase-btn:disabled {
    background: var(--ta-surface-200) !important;
    border-color: var(--ta-surface-200) !important;
    color: var(--ta-surface-500) !important;
    cursor: not-allowed; box-shadow: none !important;
}
.ta-btn-arrow {
    transition: transform 0.2s var(--ta-ease-expo);
}

/* Old qty buttons compatibility */
.ta-cart-item-qty {
    display: inline-flex; align-items: center; gap: 2px;
    background: var(--ta-surface-50); border-radius: 6px; padding: 2px;
}
.ta-qty-btn {
    width: 26px; height: 26px; border: none; border-radius: 4px;
    background: var(--ta-surface-100); cursor: pointer;
    font-size: 14px; font-weight: 600; color: var(--ta-surface-600);
    display: flex; align-items: center; justify-content: center;
    transition: all 0.15s var(--ta-ease-out);
}
.ta-qty-btn:hover { background: var(--ta-brand-400); color: #fff; }
.ta-qty-btn:active { transform: scale(0.94); }
.ta-qty-val {
    display: inline-block; min-width: 28px; text-align: center;
    font-weight: 700; font-size: 13px; color: var(--ta-surface-800);
}

/* Responsive */
@media (max-width: 780px) {
    .ta-purchase-layout { grid-template-columns: 1fr; }
    .ta-purchase-right { position: static; }
}

/* Cart animations */
@keyframes taCartFadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
}
.ta-cart-item {
    animation: taCartFadeIn 0.3s var(--ta-ease-expo) both;
}
.ta-cart-item:nth-child(1) { animation-delay: 0ms; }
.ta-cart-item:nth-child(2) { animation-delay: 50ms; }
.ta-cart-item:nth-child(3) { animation-delay: 100ms; }
.ta-cart-item:nth-child(4) { animation-delay: 150ms; }
.ta-cart-item:nth-child(5) { animation-delay: 200ms; }
@media (prefers-reduced-motion: reduce) {
    .ta-cart-item { animation: none; }
}

